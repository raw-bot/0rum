//@version=6
// AK MACD All-in-One — OPTION 1 preview: the 3 strategy indicators in ONE slot.
//
// Fits the TradingView free 2-indicator limit with room to spare (1 slot, 1 free).
// Trade-off vs the 2-slot layout: volume is shown as a COLORED BACKGROUND
// (green when volume > MA9) instead of real columns, because a single Pine
// indicator has only one sub-pane and MACD (~±0.001) and volume (~thousands)
// can't share a scale. The volume filter is boolean in the strategy anyway.
//
// Visual-only helper (no orders). Reproductions validated against the real
// indicators: AK MACD dots = slope coloring; SSL baseline EMA30 / Keltner 0.2.

indicator("AK MACD All-in-One", "AKM-ALL", overlay = false, max_labels_count = 200)

// --- AK MACD BB (slope-colored dots) ----------------------------------------
macdFast = input.int(12, "MACD fast", group = "AK MACD")
macdSlow = input.int(26, "MACD slow", group = "AK MACD")
macdSig  = input.int(9,  "MACD signal", group = "AK MACD")
macdLine   = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
signalLine = ta.ema(macdLine, macdSig)
dotGreen = macdLine > macdLine[1]              // slope: green when rising
flipUp   = macdLine > macdLine[1] and macdLine[1] <= macdLine[2]
flipDown = macdLine < macdLine[1] and macdLine[1] >= macdLine[2]
aboveZero = macdLine > 0
belowZero = macdLine < 0

// --- SSL Hybrid baseline (EMA30, Keltner continuation blue/red/gray) ---------
baseLen = input.int(30, "Baseline length", group = "SSL Hybrid")
multy   = input.float(0.2, "Base channel multiplier", group = "SSL Hybrid")
baseline = ta.ema(close, baseLen)
rangeMa  = ta.ema(ta.tr(true), baseLen)
upperK   = baseline + rangeMa * multy
lowerK   = baseline - rangeMa * multy
isBlue = close > upperK
isRed  = close < lowerK
isGray = not isBlue and not isRed
baseColor = isBlue ? color.new(color.blue, 0) : isRed ? color.new(color.red, 0) : color.new(color.gray, 0)

// --- Volume filter (shown as background) -------------------------------------
volMaLen = input.int(9, "Volume MA length", group = "Volume")
volMa = ta.sma(volume, volMaLen)
volOk = volume > volMa

// --- Entry logic (long-only by default) -------------------------------------
trendLook = input.int(50, "Trend lookback", group = "Setup")
pullLook  = input.int(10, "Pullback lookback", group = "Setup")
allowShort = input.bool(false, "Show SELL markers", group = "Setup")
wasBull = ta.barssince(isBlue) < trendLook
pulledLong = ta.barssince(isGray or isRed) < pullLook
buyCond  = wasBull and pulledLong and close > baseline and flipUp and aboveZero and volOk
wasBear = ta.barssince(isRed) < trendLook
pulledShort = ta.barssince(isGray or isBlue) < pullLook
sellCond = allowShort and wasBear and pulledShort and close < baseline and flipDown and belowZero and volOk

// --- Visual layer ------------------------------------------------------------
// Baseline on price.
plot(baseline, "MA Baseline", color = baseColor, linewidth = 2, force_overlay = true)
// Volume filter as background of THIS pane (green tint = volume above MA9).
bgcolor(volOk ? color.new(color.teal, 80) : na, title = "Volume OK")
// AK MACD dots + signal + zero line in this pane.
dotColor = dotGreen ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(macdLine, "AK MACD", color = dotColor, style = plot.style_circles, linewidth = 2)
plot(signalLine, "Signal", color = color.new(color.orange, 50))
hline(0, "Zero", color = color.new(color.gray, 50))
// Entry markers on price.
plotshape(buyCond,  title = "BUY",  style = shape.triangleup,   location = location.belowbar, color = color.lime, size = size.small, text = "BUY",  force_overlay = true)
plotshape(sellCond, title = "SELL", style = shape.triangledown, location = location.abovebar, color = color.red,  size = size.small, text = "SELL", force_overlay = true)

// --- Status table ------------------------------------------------------------
setRow(table t, int row, string k, string v) =>
    table.cell(t, 0, row, k, text_color = color.gray,  text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, v, text_color = color.white, text_size = size.small, text_halign = text.align_left)

var table dbg = table.new(position.top_right, 2, 5, border_width = 1, bgcolor = color.new(color.black, 20))
if barstate.islast
    setRow(dbg, 0, "baseline",   str.tostring(baseline, "#.#####"))
    setRow(dbg, 1, "base color", isBlue ? "blue" : isRed ? "red" : "gray")
    setRow(dbg, 2, "dots",       dotGreen ? "GREEN (rising)" : "RED (falling)")
    setRow(dbg, 3, "above zero", aboveZero ? "yes" : "no")
    setRow(dbg, 4, "vol ok",     volOk ? "yes (bg green)" : "no")
