//@version=6
// AK MACD 15m - TV-faithful to the Python brain: adds (1) MACD confirmation
// window, (2) regime filter, (3) strict trend->pullback ordering. Plus STOP/OUT
// exit markers + entry->exit connector line replaying the vizRR bracket (display
// only; default 2R). Event names stay
// BUY_CANDIDATE / SELL_CANDIDATE so the 0rum bridge can parse the payload.
indicator("AK MACD 15m", "AKM15", overlay = false, max_labels_count = 200, max_lines_count = 200, max_bars_back = 300)

// --- AK MACD BB ---
macdFast = input.int(12, "MACD fast", group = "AK MACD BB")
macdSlow = input.int(26, "MACD slow", group = "AK MACD BB")
macdSig  = input.int(9,  "MACD signal", group = "AK MACD BB")
dotMode  = input.string("slope", "Dot color logic", options = ["slope", "signal_cross"], group = "AK MACD BB")
// --- SSL Hybrid ---
baseLen  = input.int(30, "Baseline length", group = "SSL Hybrid")
baseType = input.string("EMA", "Baseline type", options = ["EMA", "SMA", "HMA", "WMA"], group = "SSL Hybrid")
atrLen   = input.int(14, "Continuation ATR length", group = "SSL Hybrid")
atrMult  = input.float(0.2, "Continuation band mult", group = "SSL Hybrid")
// --- Volume / setup ---
volMaLen  = input.int(9,  "Volume MA length", group = "Volume")
trendLook = input.int(50, "Trend lookback", group = "Setup")
pullLook  = input.int(10, "Pullback lookback", group = "Setup")
swingLook = input.int(10, "Swing lookback", group = "Setup")
// --- Confirmation (ports the Python brain) ---
confirmBars  = input.int(2, "MACD confirmation bars (strictly inc/dec)", group = "Confirmation")
windowBars   = input.int(2, "Confirm window (bars after flip)", group = "Confirmation")
regimeFilter = input.bool(true, "Regime filter (block long if unfavorable / short if favorable)", group = "Confirmation")
regimeLook   = input.int(20, "Regime lookback", group = "Confirmation")
regimeThr    = input.float(0.003, "Regime threshold (fraction, 0.003 = 0.3%)", group = "Confirmation")
// --- Output / viz ---
allowShort = input.bool(true,  "Emit SELL_CANDIDATE", group = "Output")
emitExit   = input.bool(false, "Emit EXIT on opposite MACD flip", group = "Output")
emitAlerts = input.bool(true,  "Emit alert() payloads", group = "Output")
strategyId = input.string("ak_macd_15m_v1", "Strategy id", group = "Output")
showTrades = input.bool(true, "Show STOP/OUT exit markers + entry->exit line", group = "Trade viz")
vizMaxHold = input.int(120, "Max-hold bars before forced viz exit", group = "Trade viz")
vizRR      = input.float(2.0, "TP (Reward:Risk)", minval = 0.5, maxval = 5.0, step = 0.5, group = "Trade viz", tooltip = "Take-profit = entry +/- TP x risk. Display-only on chart; live TP is strategy.yaml reward_risk_ratio.")

// --- Indicators ---
macdLine   = ta.ema(close, macdFast) - ta.ema(close, macdSlow)
signalLine = ta.ema(macdLine, macdSig)
dotGreen = dotMode == "slope" ? macdLine > macdLine[1] : macdLine > signalLine
flipUp   = dotMode == "slope" ? (macdLine > macdLine[1] and macdLine[1] <= macdLine[2]) : ta.crossover(macdLine, signalLine)
flipDown = dotMode == "slope" ? (macdLine < macdLine[1] and macdLine[1] >= macdLine[2]) : ta.crossunder(macdLine, signalLine)
aboveZero = macdLine > 0
belowZero = macdLine < 0

baseline = baseType == "SMA" ? ta.sma(close, baseLen) : baseType == "HMA" ? ta.hma(close, baseLen) : baseType == "WMA" ? ta.wma(close, baseLen) : ta.ema(close, baseLen)
atrVal = ta.atr(atrLen)
bandUp = baseline + atrVal * atrMult
bandLo = baseline - atrVal * atrMult
isBlue = close > bandUp
isRed  = close < bandLo
isGray = not isBlue and not isRed
baseColor = isBlue ? "blue" : isRed ? "red" : "gray"

volMa = ta.sma(volume, volMaLen)
volOk = volume > volMa
recentLow  = ta.lowest(low, swingLook)
recentHigh = ta.highest(high, swingLook)

// --- (2) Regime: 20-bar rolling return vs +/-0.3% ---
regRet = na(close[regimeLook]) ? 0.0 : (close - close[regimeLook]) / close[regimeLook]
regUnfav = regRet <= -regimeThr
regFav   = regRet >= regimeThr

// --- (1) MACD strictly increasing / decreasing over confirmBars+1 values ---
isIncr = true
for k = 0 to confirmBars - 1
    isIncr := isIncr and not na(macdLine[k]) and not na(macdLine[k + 1]) and macdLine[k] > macdLine[k + 1]
isDecr = true
for k = 0 to confirmBars - 1
    isDecr := isDecr and not na(macdLine[k]) and not na(macdLine[k + 1]) and macdLine[k] < macdLine[k + 1]

// --- (3) Strict order: a BLUE bar, then a GRAY/RED pullback, then now ---
seqLong = false
pfoundL = false
for op = 0 to pullLook
    if not pfoundL and (isGray[op] or isRed[op])
        pfoundL := true
        b2 = false
        for bb = op + 1 to op + trendLook
            b2 := b2 or isBlue[bb]
        seqLong := b2
seqShort = false
pfoundS = false
for op = 0 to pullLook
    if not pfoundS and (isGray[op] or isBlue[op])
        pfoundS := true
        r2 = false
        for bb = op + 1 to op + trendLook
            r2 := r2 or isRed[bb]
        seqShort := r2

otherLong  = aboveZero and close > baseline and volOk and seqLong
otherShort = belowZero and close < baseline and volOk and seqShort
regOkLong  = not regimeFilter or not regUnfav
regOkShort = not regimeFilter or not regFav

// --- Candidate machine: flip ARMS, confirmation within windowBars FIRES ---
var int armBar = na
var int armDir = 0
confirmLong  = false
confirmShort = false
risingL = not na(macdLine[1]) and macdLine > macdLine[1]
risingS = not na(macdLine[1]) and macdLine < macdLine[1]

if flipUp
    armBar := bar_index
    armDir := 1
else if flipDown and allowShort
    armBar := bar_index
    armDir := -1
else if not na(armBar)
    if bar_index > armBar + windowBars
        armBar := na
        armDir := 0
    else if armDir == 1
        if not risingL
            armBar := na
            armDir := 0
        else if isIncr and otherLong and regOkLong
            confirmLong := true
            armBar := na
            armDir := 0
    else if armDir == -1
        if not risingS
            armBar := na
            armDir := 0
        else if isDecr and otherShort and regOkShort
            confirmShort := true
            armBar := na
            armDir := 0

exitCond = emitExit and (flipDown or flipUp)
evt = confirmLong ? "BUY_CANDIDATE" : confirmShort ? "SELL_CANDIDATE" : exitCond ? "EXIT" : ""
hasEvt = evt != ""

tf0rum = timeframe.isintraday ? (timeframe.in_seconds() % 3600 == 0 ? str.tostring(timeframe.in_seconds() / 3600) + "h" : str.tostring(timeframe.in_seconds() / 60) + "m") : timeframe.isdaily ? str.tostring(timeframe.multiplier) + "d" : timeframe.isweekly ? str.tostring(timeframe.multiplier) + "w" : timeframe.period

barTimeStr = str.tostring(time, "#")
payload = '{"source":"tradingview","strategy":"' + strategyId + '","symbol":"' + syminfo.ticker + '","timeframe":"' + tf0rum + '","event":"' + evt + '","bar_time":' + barTimeStr + ',"price":' + str.tostring(close) + ',"version":"tv_ak_macd_15m_v1","macd":' + str.tostring(macdLine) + ',"signal":' + str.tostring(signalLine) + ',"baseline":' + str.tostring(baseline) + ',"base_color":"' + baseColor + '","vol_ratio":' + str.tostring(volume / volMa) + ',"baseline_at_entry":' + str.tostring(baseline) + ',"recent_low":' + str.tostring(recentLow) + ',"recent_high":' + str.tostring(recentHigh) + '}'

if barstate.isconfirmed and hasEvt and emitAlerts
    alert(payload, alert.freq_once_per_bar_close)

// --- Visual: baseline + band ---
plot(baseline, "MA Baseline", color = isBlue ? color.new(color.blue, 0) : isRed ? color.new(color.red, 0) : color.new(color.gray, 0), linewidth = 2, force_overlay = true)
plot(bandUp, "Band up", color.new(color.gray, 70), force_overlay = true)
plot(bandLo, "Band low", color.new(color.gray, 70), force_overlay = true)
plotshape(confirmLong,  title = "LONG",  style = shape.triangleup,   location = location.belowbar, color = color.lime, size = size.small, text = "LONG",  force_overlay = true)
plotshape(confirmShort, title = "SHORT", style = shape.triangledown, location = location.abovebar, color = color.red,  size = size.small, text = "SHORT", force_overlay = true)

// --- STOP/OUT exit markers (single-trade bracket replay, no line.new) ---
var bool  inTrade = false
var int   trDir = 0
var float trEntry = na
var float trSL = na
var float trTP = na
var int   trBar = na
stopHit = false
tpHit = false
float exitPx = na
if showTrades and (confirmLong or confirmShort) and not inTrade
    inTrade := true
    trDir := confirmLong ? 1 : -1
    trEntry := close
    slv = trDir == 1 ? math.min(baseline, recentLow) : math.max(baseline, recentHigh)
    trSL := slv
    rsk = trDir == 1 ? close - slv : slv - close
    trTP := trDir == 1 ? close + vizRR * rsk : close - vizRR * rsk
    trBar := bar_index
if showTrades and inTrade and bar_index > trBar
    if trDir == 1
        if low <= trSL
            stopHit := true
            exitPx := trSL
        else if high >= trTP
            tpHit := true
            exitPx := trTP
    else
        if high >= trSL
            stopHit := true
            exitPx := trSL
        else if low <= trTP
            tpHit := true
            exitPx := trTP
    if not stopHit and not tpHit and (bar_index - trBar) >= vizMaxHold
        tpHit := trDir == 1 ? close > trEntry : close < trEntry
        stopHit := not tpHit
        exitPx := close
    if stopHit or tpHit
        // diagonal connector entry -> exit (green = win, red = loss)
        line.new(trBar, trEntry, bar_index, exitPx, xloc = xloc.bar_index, color = tpHit ? color.new(color.lime, 0) : color.new(color.red, 0), width = 2, force_overlay = true)
        inTrade := false
plotshape(stopHit, title = "STOP", style = shape.xcross, location = location.abovebar, color = color.new(color.red, 0),  size = size.tiny, text = "STOP", force_overlay = true)
plotshape(tpHit,   title = "OUT",  style = shape.flag,   location = location.belowbar, color = color.new(color.lime, 0), size = size.tiny, text = "OUT",  force_overlay = true)

// --- AK MACD dots (own pane) ---
dotColor = dotGreen ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(macdLine, "AK MACD", color = dotColor, style = plot.style_circles, linewidth = 2)
plot(signalLine, "Signal", color = color.new(color.orange, 50))
hline(0, "Zero", color = color.new(color.gray, 50))

// --- Debug table (bridge reads the payload row) ---
var string lastEvt = "none"
var string lastPayload = "none"
if barstate.isconfirmed
    lastEvt := hasEvt ? evt : "none"
    lastPayload := hasEvt ? payload : "none"
setRow(table t, int row, string k, string v) =>
    table.cell(t, 0, row, k, text_color = color.gray,  text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, v, text_color = color.white, text_size = size.small, text_halign = text.align_left)
var table dbg = table.new(position.top_right, 2, 10, border_width = 1, bgcolor = color.new(color.black, 20))
if barstate.islast
    setRow(dbg, 0, "symbol/tf", syminfo.ticker + " " + tf0rum)
    setRow(dbg, 1, "MACD", str.tostring(macdLine, "#.####"))
    setRow(dbg, 2, "dots", dotGreen ? "GREEN" : "RED")
    setRow(dbg, 3, "base color", baseColor)
    setRow(dbg, 4, "regime", regFav ? "favorable" : regUnfav ? "unfavorable" : "neutral")
    setRow(dbg, 5, "armed", na(armBar) ? "no" : (armDir == 1 ? "long" : "short"))
    setRow(dbg, 6, "vol ok", volOk ? "yes" : "no")
    setRow(dbg, 7, "in trade", inTrade ? (trDir == 1 ? "long" : "short") : "flat")
    setRow(dbg, 8, "last evt", lastEvt)
    setRow(dbg, 9, "payload", lastPayload)
