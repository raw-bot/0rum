//@version=6
// Hermes Mirror — read-only mirror + candidate-signal emitter for HermesTrading.
//
// SCOPE (strict): this script NEVER places an order, never executes, never
// decides. It mirrors the Hermes DSL indicator vocabulary on the chart and
// EMITS candidate signals as a stable, versioned JSON payload. HermesTrading
// stays the master: validation, risk gates, idempotence, position state and
// accounting all happen Python-side (Phases 1-4). Paper only.
//
// Parity notes vs hermes_trading/dsl/indicators.py:
//   - RSI = Wilder (ta.rsi)            -> matches
//   - ATR = RMA Wilder (ta.atr)        -> matches
//   - Bollinger = population stdev     -> ta.stdev default (biased) matches
//   - EMA seed differs (ta.ema seeds recursively; Hermes seeds on SMA of the
//     first `period`): expect a small warm-up divergence that converges.
//   - regime = rolling 20-bar return, +/-0.3% -> reimplemented exactly below.

indicator("Hermes Mirror", "HMIRROR", overlay = true, max_labels_count = 200)

// ----- Inputs (defaults baked to the requested Hermes config) -----------------
emaFastLen    = input.int(9,    "EMA fast")
emaMidLen     = input.int(21,   "EMA mid")
emaSlowLen    = input.int(50,   "EMA slow")
sma52Len      = input.int(52,   "SMA length (daily background filter)")
rsiLen        = input.int(14,   "RSI length")
atrLen        = input.int(14,   "ATR length")
bbLen         = input.int(20,   "Bollinger length")
bbMult        = input.float(2.0,"Bollinger stddev")
useRsiGuard   = input.bool(true,"Require RSI < overbought for BUY")
rsiOverbought = input.int(70,   "RSI overbought")
allowShort    = input.bool(false,"Emit SELL_CANDIDATE (engine is long-only)")
emitAlerts    = input.bool(true, "Emit alert() payloads (once per bar close)")
strategyId    = input.string("hermes_mirror_v1", "Strategy id (must match Hermes allowlist)")

// ----- Indicators (Hermes DSL whitelist) -------------------------------------
emaFast = ta.ema(close, emaFastLen)
emaMid  = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
// SMA 52 on the DAILY timeframe: a true "52-day" background filter regardless
// of the chart timeframe. lookahead_off so it never repaints.
sma52d  = request.security(syminfo.tickerid, "D", ta.sma(close, sma52Len), lookahead = barmerge.lookahead_off)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
bbBasis = ta.sma(close, bbLen)
bbDev   = bbMult * ta.stdev(close, bbLen)   // biased=true default -> population, matches Hermes
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// ----- Hermes rolling-return regime (EXACT parity: lookback 20, +/-0.3%) ------
regLookback = 20
regThresh   = 0.003
regRet      = (close - close[regLookback - 1]) / close[regLookback - 1]
hermesRegime = na(close[regLookback - 1]) ? "unknown" : regRet >= regThresh ? "favorable" : regRet <= -regThresh ? "unfavorable" : "neutral"

// ----- Background trend filter (SMA 52 daily) --------------------------------
bgUp = close > sma52d

// ----- Hoisted crossovers (parity rule: never call ta.cross* inside an if) ----
xUp   = ta.crossover(emaFast, emaMid)
xDown = ta.crossunder(emaFast, emaMid)
lostTrend = close < sma52d and close[1] >= sma52d[1]

// ----- Candidate events (Hermes decides; this only PROPOSES) ------------------
buyCond  = xUp and bgUp and (not useRsiGuard or rsiVal < rsiOverbought)
exitCond = xDown or lostTrend
sellCond = allowShort and xDown and not bgUp

evt = buyCond ? "BUY_CANDIDATE" : exitCond ? "EXIT" : sellCond ? "SELL_CANDIDATE" : ""
hasEvt = evt != ""

// ----- Timeframe in Hermes notation ("15m","1h","1d","1w") --------------------
tfHermes = timeframe.isintraday ? (timeframe.in_seconds() % 3600 == 0 ? str.tostring(timeframe.in_seconds() / 3600) + "h" : str.tostring(timeframe.in_seconds() / 60) + "m") : timeframe.isdaily ? str.tostring(timeframe.multiplier) + "d" : timeframe.isweekly ? str.tostring(timeframe.multiplier) + "w" : timeframe.period

// ----- Stable, versioned payload for the orchestrator -------------------------
// bar_time is `time` = bar-open epoch in MILLISECONDS (matches Hermes ms canon).
// Hermes recomputes its own dedup key from (source|strategy|symbol|timeframe|
// event|bar_time), so no sig_key is sent. The extra indicator fields are NOT
// read by the validator (decision is unchanged); they are kept in `raw` purely
// to make the external_signals.jsonl audit trail readable.
barTimeStr = str.tostring(time, "#")
payload = '{"source":"tradingview","strategy":"' + strategyId + '","symbol":"' + syminfo.ticker + '","timeframe":"' + tfHermes + '","event":"' + evt + '","bar_time":' + barTimeStr + ',"price":' + str.tostring(close) + ',"version":"tv_hermes_mirror_v1","rsi":' + str.tostring(rsiVal) + ',"atr":' + str.tostring(atrVal) + ',"regime":"' + hermesRegime + '","ema_fast":' + str.tostring(emaFast) + ',"ema_mid":' + str.tostring(emaMid) + ',"ema_slow":' + str.tostring(emaSlow) + ',"sma52d":' + str.tostring(sma52d) + '}'

// Emit only on a CONFIRMED (closed) bar -> no repaint, no intrabar signal.
if barstate.isconfirmed and hasEvt and emitAlerts
    alert(payload, alert.freq_once_per_bar_close)

// ----- Visual layer -----------------------------------------------------------
plot(emaFast, "EMA 9",   color.new(color.yellow,  0))
plot(emaMid,  "EMA 21",  color.new(color.orange,  0))
plot(emaSlow, "EMA 50",  color.new(color.fuchsia, 0))
plot(sma52d,  "SMA 52D", color.new(color.aqua,    0), linewidth = 2)
bgcolor(bgUp ? color.new(color.green, 92) : color.new(color.red, 92), title = "Background filter")

plotshape(buyCond,  title = "BUY",  style = shape.triangleup,   location = location.belowbar, color = color.lime,   size = size.small, text = "BUY")
plotshape(exitCond, title = "EXIT", style = shape.xcross,       location = location.abovebar, color = color.orange, size = size.tiny,  text = "EXIT")
plotshape(sellCond, title = "SELL", style = shape.triangledown, location = location.abovebar, color = color.red,    size = size.small, text = "SELL")

// ----- Debug table (read by MCP data_get_pine_tables to compare Pine<->Python)-
var string lastPayload = "none"
var string lastEvt     = "none"
if barstate.isconfirmed and hasEvt
    lastPayload := payload
    lastEvt     := evt

setRow(table t, int row, string k, string v) =>
    table.cell(t, 0, row, k, text_color = color.gray,  text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, row, v, text_color = color.white, text_size = size.small, text_halign = text.align_left)

var table dbg = table.new(position.top_right, 2, 14, border_width = 1, bgcolor = color.new(color.black, 20))
if barstate.islast
    setRow(dbg, 0,  "symbol/tf", syminfo.ticker + " " + tfHermes)
    setRow(dbg, 1,  "close",     str.tostring(close))
    setRow(dbg, 2,  "EMA 9",     str.tostring(emaFast, "#.##"))
    setRow(dbg, 3,  "EMA 21",    str.tostring(emaMid,  "#.##"))
    setRow(dbg, 4,  "EMA 50",    str.tostring(emaSlow, "#.##"))
    setRow(dbg, 5,  "SMA 52D",   str.tostring(sma52d,  "#.##"))
    setRow(dbg, 6,  "RSI(14)",   str.tostring(rsiVal,  "#.##"))
    setRow(dbg, 7,  "ATR(14)",   str.tostring(atrVal,  "#.##"))
    setRow(dbg, 8,  "BB mid",    str.tostring(bbBasis, "#.##"))
    setRow(dbg, 9,  "regime",    hermesRegime)
    setRow(dbg, 10, "bg filter", bgUp ? "UP (close>SMA52D)" : "DOWN")
    setRow(dbg, 11, "last evt",  lastEvt)
    setRow(dbg, 12, "strategy",  strategyId + " / tv_hermes_mirror_v1")
    setRow(dbg, 13, "payload",   lastPayload)
