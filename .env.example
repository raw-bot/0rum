# === MARKET DATA ===
# Current runtime still uses Binance public API (PAXG/USDT proxy) by default.
# IG variables below are kept only for legacy compatibility/debug.

# === IG DEMO (LEGACY / INACTIVE) ===
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=
IG_ACCOUNT_ID=
IG_API_URL=https://demo-api.ig.com/gateway/deal
# Fill only if IG path is explicitly reactivated.
IG_XAUUSD_EPIC=

# === IG-LIGHT INGESTION LIMITS (LEGACY / IG PATH ONLY) ===
# Per-timeframe bar counts for bounded warm-up if IG is manually re-enabled.
IG_WARMUP_BARS_M15=300
IG_WARMUP_BARS_H1=250
IG_WARMUP_BARS_H4=80
IG_WARMUP_BARS_D1=60
# Gap fills requesting more bars than this are skipped with a warning on IG.
IG_MAX_GAP_BARS=100

# === MARKET DATA PROVIDER ===
MARKET_DATA_PROVIDER=binance

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://orum:orum@postgres:5432/orum
REDIS_URL=redis://redis:6379/0

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# === EXECUTION MODE ===
EXECUTION_MODE=signal

# === RISK (TOUS FIXÉS) ===
RISK_PER_TRADE=0.01
DAILY_LOSS_LIMIT=-0.03
MAX_POSITIONS=5
MAX_SIGNALS_PER_DAY=5
CIRCUIT_BREAKER_STOPS=8
CIRCUIT_BREAKER_COOLDOWN_HOURS=24
ATR_HIGH_VOL_PERCENTILE=90
ATR_LOW_VOL_PERCENTILE=10
HARD_CAP_RISK=0.02

# === OPTIMIZER ===
OPTIMIZER_INTERVAL_HOURS=24
BACKTEST_INTERVAL_HOURS=8
WF_TRAIN_MONTHS=6
WF_TEST_MONTHS=2
LHS_COMBOS=100
WFE_MINIMUM=0.50
