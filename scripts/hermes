#!/usr/bin/env bash
# hermes — one-switch control for the Hermes trading bot.
#
#   hermes start      start the trading engine (worker + watcher + bridge)
#   hermes stop       stop the trading engine (dashboard keeps running)
#   hermes restart    stop then start the engine
#   hermes status     show dashboard + engine + TradingView state
#   hermes logs       follow the engine log (Ctrl-C to quit)
#   hermes dash       open the dashboard in the browser
#   hermes dash-up    install + start the always-on dashboard (launchd)
#   hermes dash-down  stop the always-on dashboard (launchd)
#
# The dashboard is meant to run always-on under launchd (hermes dash-up once).
# The engine runs only while you want to trade — toggled here or from the
# dashboard's Start/Stop button. Both share state/worker.pid, so they agree.

set -u

PROJECT="/Applications/HermesTrading/.sandbox/hermes-one-shot-home/hermes-trading"
PY="$PROJECT/.venv/bin/python3"
PIDFILE="$PROJECT/state/worker.pid"
ENGINE_LOG="$PROJECT/state/run_engine.out"
DASH_URL="http://127.0.0.1:8787"
LABEL="com.hermes.dashboard"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

c_g=$'\033[32m'; c_r=$'\033[31m'; c_y=$'\033[33m'; c_d=$'\033[2m'; c_0=$'\033[0m'

engine_pid() { [ -f "$PIDFILE" ] && cat "$PIDFILE" 2>/dev/null; }
engine_alive() { local p; p=$(engine_pid); [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

engine_start() {
  if engine_alive; then echo "${c_y}engine already running${c_0} (pid $(engine_pid))"; return 0; fi
  "$PY" - "$PROJECT" <<'PY'
import os, sys, subprocess, pathlib
root = pathlib.Path(sys.argv[1])
log = open(root/"state"/"run_engine.out", "a")
env = {**os.environ, "AK_MACD_LIVE": "1"}
env["PATH"] = os.path.expanduser("~/.local/bin")+":/opt/homebrew/bin:/usr/local/bin:"+env.get("PATH","/usr/bin:/bin")
p = subprocess.Popen(["/bin/bash", str(root/"scripts"/"run_engine.sh")],
                     cwd=root, stdout=log, stderr=log, env=env, start_new_session=True)
(root/"state"/"worker.pid").write_text(str(p.pid))
print(p.pid)
PY
  sleep 2
  if engine_alive; then echo "${c_g}● engine started${c_0} (pid $(engine_pid)) — live paper"; else
    echo "${c_r}✗ engine failed to start${c_0} — see: hermes logs"; return 1; fi
}

engine_stop() {
  local p; p=$(engine_pid)
  if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then rm -f "$PIDFILE"; echo "engine was not running"; return 0; fi
  # kill the whole engine session (worker + watcher + bridge), never the dashboard
  kill -TERM -- "-$(ps -o pgid= -p "$p" | tr -d ' ')" 2>/dev/null || kill -TERM "$p" 2>/dev/null
  sleep 1; pkill -f "scripts/run_engine.sh" 2>/dev/null
  rm -f "$PIDFILE"
  echo "${c_r}○ engine stopped${c_0}"
}

dash_running() { curl -fsS -m 2 "$DASH_URL/api/state" >/dev/null 2>&1; }

dash_up() {
  [ -f "$PLIST" ] || { echo "${c_r}missing $PLIST${c_0} — run the installer first"; return 1; }
  launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null
  launchctl enable "$DOMAIN/$LABEL" 2>/dev/null
  launchctl kickstart "$DOMAIN/$LABEL" 2>/dev/null
  for _ in $(seq 1 15); do dash_running && { echo "${c_g}● dashboard up${c_0} → $DASH_URL"; return 0; }; sleep 1; done
  echo "${c_y}dashboard agent loaded but not answering yet${c_0} → $DASH_URL"
}

dash_down() { launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null; echo "${c_r}○ dashboard stopped${c_0}"; }

status() {
  echo "${c_d}── Hermes ─────────────────────────────${c_0}"
  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    if dash_running; then echo "dashboard   ${c_g}● up${c_0} (launchd) → $DASH_URL"
    else echo "dashboard   ${c_y}● loaded, starting…${c_0} → $DASH_URL"; fi
  else echo "dashboard   ${c_r}○ off${c_0}  (hermes dash-up)"; fi

  if engine_alive; then echo "engine      ${c_g}● running${c_0} (pid $(engine_pid)) — live paper"
  else echo "engine      ${c_r}○ stopped${c_0}  (hermes start)"; fi

  local n; n=$(pgrep -f "external.bridge" 2>/dev/null | wc -l | tr -d ' ')
  echo "  bridge    $([ "$n" -gt 0 ] && echo "${c_g}● $n${c_0}" || echo "${c_r}○ 0${c_0}")  worker $(pgrep -f hermes_trading.run >/dev/null && echo "${c_g}●${c_0}" || echo "${c_r}○${c_0}")  watcher $(pgrep -f hermes_watch >/dev/null && echo "${c_g}●${c_0}" || echo "${c_r}○${c_0}")"
  if pgrep -f "TradingView.app/Contents/MacOS" >/dev/null 2>&1; then echo "tradingview ${c_g}● open${c_0} (bridge can read AK MACD 15m)"
  else echo "tradingview ${c_r}○ closed${c_0} — engine will get NO signals"; fi
}

case "${1:-status}" in
  start)      dash_running || dash_up >/dev/null 2>&1; engine_start ;;
  stop)       engine_stop ;;
  restart)    engine_stop; sleep 1; engine_start ;;
  status|st)  status ;;
  logs|log)   echo "${c_d}tail -f $ENGINE_LOG (Ctrl-C to quit)${c_0}"; touch "$ENGINE_LOG"; tail -n 30 -f "$ENGINE_LOG" ;;
  dash|open)  open "$DASH_URL" ;;
  dash-up|up) dash_up ;;
  dash-down|down) dash_down ;;
  *) echo "usage: hermes {start|stop|restart|status|logs|dash|dash-up|dash-down}"; exit 1 ;;
esac
