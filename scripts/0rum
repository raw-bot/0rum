#!/usr/bin/env bash
# 0rum — dashboard controls and operational paper status.
# start/stop/restart belonged to the retired mono-asset worker and are refused.
# Current service ownership and explicit commands: docs/OPERATING-MODES.md.

set -u

case "${1:-status}" in
  start|stop|restart)
    printf '%s\n' 'Legacy mono-asset controls retired. Use the documented com.0rum.paper service controls; no service was changed.' >&2
    exit 64
    ;;
esac


PROJECT="/Applications/0rum/.sandbox/0rum-one-shot-home/0rum-trading"
PY="$PROJECT/.venv/bin/python3"
ENGINE_LOG="$PROJECT/state/paper.out"
DASH_URL="http://127.0.0.1:8787"
LABEL="com.0rum.dashboard"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

c_g=$'\033[32m'; c_r=$'\033[31m'; c_y=$'\033[33m'; c_d=$'\033[2m'; c_0=$'\033[0m'

dash_running() { curl -fsS -m 2 "$DASH_URL/api/state" >/dev/null 2>&1; }

dash_up() {
  [ -f "$PLIST" ] || { echo "${c_r}missing $PLIST${c_0} — run the installer first"; return 1; }
  launchctl bootstrap "$DOMAIN" "$PLIST" 2>/dev/null
  launchctl enable "$DOMAIN/$LABEL" 2>/dev/null
  launchctl kickstart "$DOMAIN/$LABEL" 2>/dev/null
  for _ in $(seq 1 15); do dash_running && { echo "${c_g}● dashboard up${c_0} → $DASH_URL"; return 0; }; sleep 1; done
  echo "${c_y}dashboard agent loaded but not answering yet${c_0} → $DASH_URL"
}

dash_down() { launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null; echo "${c_r}○ dashboard stopped${c_0}"; }

status() {
  echo "${c_d}── 0rum ─────────────────────────────${c_0}"
  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    if dash_running; then echo "dashboard   ${c_g}● up${c_0} (launchd) → $DASH_URL"
    else echo "dashboard   ${c_y}● loaded, starting…${c_0} → $DASH_URL"; fi
  else echo "dashboard   ${c_r}○ off${c_0}  (0rum dash-up)"; fi

  "$PY" - "$PROJECT/state/paper_runtime_status.json" <<'PY_STATUS'
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
try:
    state = json.loads(path.read_text())
except (OSError, ValueError) as exc:
    print(f"paper       status unavailable: {exc}")
else:
    print(f"paper       {state.get('status', 'unknown')} — {state.get('execution_method', 'unknown')}")
    print(f"last cycle  {state.get('ts', 'unknown')} (inspect freshness before claiming it is running)")
print("service     com.0rum.paper; legacy mono-asset engine retired")
PY_STATUS
}

case "${1:-status}" in
  status|st)  status ;;
  logs|log)   echo "${c_d}tail -f $ENGINE_LOG (Ctrl-C to quit)${c_0}"; tail -n 30 -f "$ENGINE_LOG" ;;
  dash|open)  open "$DASH_URL" ;;
  dash-up|up) dash_up ;;
  dash-down|down) dash_down ;;
  *) echo "usage: 0rum {status|logs|dash|dash-up|dash-down}"; exit 1 ;;
esac
